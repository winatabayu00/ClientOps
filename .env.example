# Application
APP_ENV=development
APP_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=15432
POSTGRES_DB=clientops
POSTGRES_USER=clientops
POSTGRES_PASSWORD=clientops_dev
DATABASE_URL=postgres://clientops:clientops_dev@postgres:5432/clientops?sslmode=disable

# Authentication - development placeholders only; replace outside local development
ACCESS_TOKEN_KEY=replace-with-a-long-random-access-secret
COOKIE_SECURE=false

# Initial administrator. Required by `make seed`; never commit a real password.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=password
ADMIN_NAME=System Administrator

# Redis
REDIS_ADDR=redis:6379
REDIS_HOST_PORT=16379

# Optional SMTP notifications. Empty disables email while retaining in-app notifications.
# URL format: smtp://username:password@smtp.example.com:587?from=clientops@example.com
SMTP_URL=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=clientops_dev
MINIO_SECRET_KEY=replace-with-a-long-random-minio-secret
MINIO_BUCKET=clientops
# API uses the internal endpoint above. Do not expose this bucket publicly.
